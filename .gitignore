# =========================
# PyInstaller
# =========================
# Папки, создаваемые при сборке (exe, app, временные файлы)
build/
dist/
*.manifest
*.spec

# Исключение: если вы настроили .spec файл вручную (добавили шрифты, иконки),
# то раскомментируйте строку ниже, чтобы сохранить его в репозитории:
# !sudoku_slavonic.spec

# =========================
# Python
# =========================
# Байт-код и кэш
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Виртуальные окружения
venv/
.venv/
env/
ENV/
.python-version

# Файлы настроек и покрытия
.pytest_cache/
.coverage
htmlcov/

# =========================
# Шрифты (на ваше усмотрение)
# =========================
# Если вы НЕ хотите хранить бинарные файлы шрифтов в репозитории
# (например, из-за лицензии или размера), раскомментируйте строку ниже:
# fonts/*.ttf
# fonts/*.otf
# В таком случае не забудьте указать в README, где их скачать.

# =========================
# Операционные системы
# =========================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory
.Trash-*

# =========================
# Редакторы и IDE
# =========================
# VS Code
.vscode/
# PyCharm / IntelliJ
.idea/
*.iml
# Sublime Text
*.sublime-workspace